@page "/minutas"
@using ControleMinutas.DTOs

<h3>Minutas</h3>

<button class="btn btn-primary" @onclick="MostrarModalMinutaHandle">
    Abrir Modal
</button>

<Modal Mostrar="@MostrarMinutaModal"
       AoFechar="@FecharMinutaModal">

   
</Modal>



<Modal Mostrar="@MostrarMinutaModal"
       AoFechar="@FecharMinutaModal">
    <ConteudoCorpo>
        <Form TModel="MinutaModel"
              Model="modeloMinuta"
              AoSalvar="@Salvar"
              AoCancelar="@FecharMinutaModal"
              Carregando="@Carregando"
              MostrarBotaoCancelar="@MostrarBotaoCancelar"
              TextoBotaoCancelar="Cancelar"
              TextoBotaoSalvar="Salvar">

            <InputCurrency Label="Valor" @bind-Value="modeloMinuta.Valor" />
            <SelectRegistration TValue="string" Label="Terminal Saída" AoAdicionarNovoValor="@AdicionarNovoStatus" @bind-Value="modeloMinuta.Status">
                <option value="">Selecione um status</option>
                @foreach (var status in StatusOptions)
                {
                    <option value="@status">@status</option>
                }
            </SelectRegistration>
        </Form>
    </ConteudoCorpo>
    <ConteudoFooter>
        <button class="btn btn-secondary" @onclick="FecharMinutaModal">Fechar</button>
    </ConteudoFooter>
</Modal>

@code {

    private MinutaModel modeloMinuta = new MinutaModel();
    private bool Carregando { get; set; } = false;
    private bool MostrarBotaoCancelar { get; set; } = true;

    private List<string> StatusOptions { get; set; } = new List<string> { "Status 1", "Status 2", "Status 3" };

    private async Task AdicionarNovoStatus(string novoStatus)
    {
        if (!string.IsNullOrWhiteSpace(novoStatus) && !StatusOptions.Contains(novoStatus))
        {
            StatusOptions.Add(novoStatus);
            await InvokeAsync(StateHasChanged);
        }
    }

    private bool MostrarMinutaModal { get; set; } = false;
    private bool MostrarEmpresaModal { get; set; } = false;

    private async Task Salvar(MinutaModel model)
    {
        Carregando = true;
        await Task.Delay(2000);
        Carregando = false;
        FecharMinutaModal();
    }

    private void MostrarModalMinutaHandle()
    {
        MostrarMinutaModal = true;
    }

    private void FecharMinutaModal()
    {
        MostrarMinutaModal = false;
        modeloMinuta = new MinutaModel();
    }

    private void MostrarModalEmpresaHandle()
    {
        MostrarEmpresaModal = true;
    }

    private void FecharEmpresaModal()
    {
        MostrarEmpresaModal = false;
    }

}
