@page "/minutas"
@using ControleMinutas.DTOs
@using ControleMinutas.Database
@using ControleMinutas.Entities
@using ControleMinutas.Interfaces.Repositories

@inject IWriteRepository<Empresa> EmpresaRepository;
@inject IReadRepository<Empresa> EmpresaReadRepository;

<h3>Minutas</h3>

<button class="btn btn-primary" @onclick="MostrarModalMinutaHandle">
    Abrir Modal
</button>
<button class="btn btn-primary" @onclick="MostrarModalEmpresaHandle">
    Abrir Empresa Modal
</button>

<TablePagination TItem="Empresa"
                 Itens="empresas"
                 MostrarAcoes="true"
                 AoEditar="@EditarEmpresa"
                 AoExcluir="@ExcluirEmpresa"
                 AoMudarPagina="@CarregarEmpresas">
    <Cabecalho>
        <th>
            ID
        </th>
        <th>
            Nome da Empresa
        </th>
        <th>
            Taxa de Abastecimento
        </th>
        <th>
            Taxa de Troca
        </th>
    </Cabecalho>

    <Linha Context="empresa">
        <td>@empresa.Id</td>
        <td>@empresa.Nome</td>
        <td>@empresa.TaxaAbastecimento</td>
        <td>@empresa.TaxaTroca</td>
    </Linha>

</TablePagination>




<Modal Mostrar="@MostrarEmpresaModal"
       AoFechar="@FecharEmpresaModal">
    <ConteudoCorpo>
        <Form TModel="EmpresaModel"
              Model="modeloEmpresa"
              AoSalvar="@SalvarEmpresa"
              AoCancelar="@FecharEmpresaModal"
              Carregando="@CarregandoEmpresa"
              MostrarBotaoCancelar="true"
              TextoBotaoCancelar="Cancelar"
              TextoBotaoSalvar="Salvar">

            <InputTextStandard Label="Nome da Empresa" @bind-Value="modeloEmpresa.Nome" />
            <InputPercentage Label="Taxa de Abastecimento" @bind-Value="modeloEmpresa.TaxaAbastecimento" />
            <InputPercentage Label="Taxa de Troca" @bind-Value="modeloEmpresa.TaxaTroca" />

        </Form>
    </ConteudoCorpo>
    <ConteudoFooter>

    </ConteudoFooter>
</Modal>



<Modal Mostrar="@MostrarMinutaModal"
       AoFechar="@FecharMinutaModal">
    <ConteudoCorpo>
        <Form TModel="MinutaModel"
              Model="modeloMinuta"
              AoSalvar="@SalvarMinuta"
              AoCancelar="@FecharMinutaModal"
              Carregando="@CarregandoMinuta"
              MostrarBotaoCancelar="true"
              TextoBotaoCancelar="Cancelar"
              TextoBotaoSalvar="Salvar">

            <InputCurrency Label="Valor" @bind-Value="modeloMinuta.Valor" />
            <SelectRegistration TValue="string" Label="Terminal Saída" AoAdicionarNovoValor="@AdicionarNovoStatus" @bind-Value="modeloMinuta.Status">
                <option value="">Selecione um status</option>
                @foreach (var status in StatusOptions)
                {
                    <option value="@status">@status</option>
                }
            </SelectRegistration>
        </Form>
    </ConteudoCorpo>
    <ConteudoFooter>
        <button class="btn btn-secondary" @onclick="FecharMinutaModal">Fechar</button>
    </ConteudoFooter>
</Modal>

@code {

    private List<Empresa> empresas = new List<Empresa>();
    private int paginaAtual = 1;
    private int totalPaginas = 1;
    private int tamanhoPagina = 10;

    protected override async Task OnInitializedAsync()
    {
        await CarregarEmpresas(1);
    }


    private async Task CarregarEmpresas(int novaPagina)
    {
        paginaAtual = novaPagina;
        PagedResult<Empresa> resultadoPaginado = await EmpresaReadRepository.ObterPaginadoAsync(
            paginaAtual,
            tamanhoPagina,
            null,
            null
        );

        if (resultadoPaginado.Success)
        {
            empresas = resultadoPaginado.Entidades?.ToList() ?? new List<Empresa>();
            totalPaginas = ((dynamic)resultadoPaginado).TotalPaginas;
        }
    }

    private void EditarEmpresa()
    {

    }

    private void ExcluirEmpresa()
    {

    }

    private MinutaModel modeloMinuta = new MinutaModel();
    private EmpresaModel modeloEmpresa = new EmpresaModel();

    private bool CarregandoMinuta { get; set; } = false;
    private bool CarregandoEmpresa { get; set; } = false;

    private List<string> StatusOptions { get; set; } = new List<string> { "Status 1", "Status 2", "Status 3" };

    private async Task AdicionarNovoStatus(string novoStatus)
    {
        if (!string.IsNullOrWhiteSpace(novoStatus) && !StatusOptions.Contains(novoStatus))
        {
            StatusOptions.Add(novoStatus);
            await InvokeAsync(StateHasChanged);
        }
    }

    private bool MostrarMinutaModal { get; set; } = false;
    private bool MostrarEmpresaModal { get; set; } = false;

    private async Task SalvarEmpresa(EmpresaModel model)
    {
        CarregandoEmpresa = true;

        Empresa empresa = Empresa.CriarEmpresa(model.Nome, model.TaxaAbastecimento, model.TaxaTroca);

        await EmpresaRepository.AddAsync(empresa);

        CarregandoEmpresa = false;
        FecharEmpresaModal();
    }

    private async Task SalvarMinuta(MinutaModel model)
    {
        CarregandoMinuta = true;
        await Task.Delay(2000);
        CarregandoMinuta = false;
        FecharMinutaModal();
    }

    private void MostrarModalMinutaHandle()
    {
        MostrarMinutaModal = true;
    }

    private void FecharMinutaModal()
    {
        MostrarMinutaModal = false;
        modeloMinuta = new MinutaModel();
    }

    private void MostrarModalEmpresaHandle()
    {
        MostrarEmpresaModal = true;
    }

    private void FecharEmpresaModal()
    {
        MostrarEmpresaModal = false;
    }

}
